# App auth (optional in local dev — leave APP_PASSWORD unset/empty to skip login)
APP_PASSWORD=changeme
APP_SESSION_SECRET=replace-with-a-long-random-string

# Encrypts Arr API keys in SQLite (32 bytes, base64 or hex). Required in production.
# Generate: openssl rand -base64 32
INSTANCE_SECRETS_KEY=

# SQLite database (optional — default data/umbrellarr.db)
# DATABASE_PATH=

# Server
PORT=3000
HOST=0.0.0.0

# First-run only: if the SQLite instances table is empty, these are imported once.
# After that, manage clients in Settings (SQLite is the source of truth).
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
SONARR_URL=http://localhost:8989
SONARR_API_KEY=
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=
SEERR_URL=http://localhost:5055
SEERR_API_KEY=
# RADARR_4K_URL=http://localhost:7879
# RADARR_4K_API_KEY=
